# Nginx Server Block Configuration Example
# Place this inside your server block, typically in /etc/nginx/sites-available/default or /etc/nginx/nginx.conf

server {
    listen 80;
    server_name aicte-vaani.sipnaengg.ac.in; # Subdomain configuration
    
    # Absolute path to the dist/ build output directory on your server
    root /var/www/html/aicte-vaani/dist; 
    index index.html;

    # SPA Fallback client-side routing rewrite rule
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static asset mime-type handling, caching, and compression optimization
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|webp|woff|woff2|ttf|eot)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, no-transform";
    }

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml image/svg+xml;
    gzip_disable "MSIE [1-6]\.";
}
